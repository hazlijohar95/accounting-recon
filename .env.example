# Convex
NEXT_PUBLIC_CONVEX_URL=

# WorkOS Auth
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
NEXT_PUBLIC_WORKOS_CLIENT_ID=  # Same as WORKOS_CLIENT_ID - needed for client-side auth checks
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback  # Change to production URL in prod

# WorkOS AuthKit Session (REQUIRED)
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Extraction Provider Toggle (bedrock | gemini)
# - bedrock: PDF.js client-side rendering + Bedrock Vision per page (default)
# - gemini: Whole PDF sent to Gemini via Vertex AI (no PDF.js needed)
EXTRACTION_PROVIDER=bedrock
NEXT_PUBLIC_EXTRACTION_PROVIDER=bedrock

# AWS Bedrock (required when EXTRACTION_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Agentic Assistant Model (optional, defaults to Claude Opus 4.5)
# Override to use a different model for the reconciliation agent
BEDROCK_AGENT_MODEL_ID=us.anthropic.claude-opus-4-5-20251101-v1:0

# Google Cloud / Vertex AI Express (required when EXTRACTION_PROVIDER=gemini)
# Set these in both .env and Convex env (npx convex env set)
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us-central1
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reconciled-documents

# Cloudinary (DEPRECATED - now using native PDF.js extraction)
# These are no longer required as of the native PDF extraction update.
# PDF files are now rendered client-side using PDF.js, eliminating
# the need for Cloudinary's PDF-to-image conversion.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ML Extraction Service (deprecated - using Cloudinary + Claude Vision now)
ML_SERVICE_URL=https://reconciled-ml.railway.app

# Mistral OCR (deprecated)
MISTRAL_API_KEY=

# Convex Webhook Secret (for extraction results callback)
CONVEX_WEBHOOK_SECRET=

# Sentry Error Tracking (optional, but recommended for production)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Upstash Redis (optional, for scalable rate limiting across instances)
# Get credentials from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature Flags
# Enable unified spreadsheet with full features (editing, charts, formatting, import)
# When enabled, SpreadsheetView uses UnifiedSheet with:
# - Full cell editing (when not in demo mode)
# - Conditional formatting with presets
# - Charts (bar, line, pie, area)
# - Data validation with dropdowns
# - Import from reconciliation sessions (requires workspace selection)
# Set to 'true' after testing with actual reconciliation data
NEXT_PUBLIC_USE_UNIFIED_SHEET=false
