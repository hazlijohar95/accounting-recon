# Convex
NEXT_PUBLIC_CONVEX_URL=

# WorkOS Auth
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
NEXT_PUBLIC_WORKOS_CLIENT_ID=  # Same as WORKOS_CLIENT_ID - needed for client-side auth checks
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback  # Change to production URL in prod

# WorkOS AuthKit Session (REQUIRED)
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# AWS Bedrock (future - for ML service)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reconciled-documents

# ML Extraction Service
ML_SERVICE_URL=https://reconciled-ml.railway.app

# Mistral OCR
MISTRAL_API_KEY=

# Convex Webhook Secret (for extraction results callback)
CONVEX_WEBHOOK_SECRET=

# Sentry Error Tracking (optional, but recommended for production)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Upstash Redis (optional, for scalable rate limiting across instances)
# Get credentials from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
