{
  "name": "reconciled",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:convex": "convex dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:convex\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "convex:push": "convex deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:python": "cd ml && pytest -v",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:python",
    "remotion:preview": "remotion preview remotion/index.ts",
    "remotion:render": "mkdir -p out && remotion render remotion/index.ts LaunchVideo out/launch-video.mp4 --gl=angle",
    "remotion:still": "mkdir -p out && remotion still remotion/index.ts LaunchVideo out/thumbnail.png --frame=300 --gl=angle"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.41",
    "@ai-sdk/react": "^3.0.64",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/workos-authkit": "^0.1.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@remotion/cli": "^4.0.414",
    "@remotion/player": "^4.0.414",
    "@remotion/three": "^4.0.414",
    "@remotion/transitions": "^4.0.414",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.13.7",
    "@vercel/analytics": "^1.4.1",
    "@workos-inc/authkit-nextjs": "^2.13.0",
    "@workos-inc/node": "^8.0.0",
    "ai": "^6.0.62",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "convex": "^1.31.7",
    "csv-stringify": "^6.6.0",
    "next": "16.1.6",
    "next-themes": "^0.4.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remotion": "^4.0.414",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.34",
    "eslint": "^9.39.2",
